---
import Layout from '../layouts/Layout.astro';
import { searchCompanies, getMeta } from '../lib/db';
import { regions, districts, districtsByRegion, sizeBands, sizes, forms } from '../lib/codelists';
import { date } from '../lib/format';

const params = Astro.url.searchParams;
const q = (params.get('q') || '').trim().slice(0, 500);
let region = params.get('region') || '';
let district = params.get('district') || '';
let size = params.get('size') || '';
if (!Object.hasOwn(regions, region)) region = '';
if (!Object.hasOwn(districts, district)) district = '';
if (!Object.hasOwn(sizeBands, size)) size = '';
// A district outside the chosen region wins: it is the more specific choice.
if (district && region && !district.startsWith(region)) region = '';
const includeDissolved = params.get('includeDissolved') === '1';

const result = searchCompanies({
  q,
  region,
  district,
  size,
  includeDissolved,
  page: Number(params.get('page') || 1),
});
const meta = getMeta();

function pageLink(page: number) {
  const next = new URLSearchParams(params);
  next.set('page', String(page));
  return '/?' + next;
}

// The column header already says "Employees".
const sizeShort = (code: string) => (sizes[code] || 'Not reported').replace(' employees', '');
---

<Layout title="Companies | CZ Company Explorer">
  <h1 class="font-display text-h3 font-semibold">Companies</h1>

  <form method="get" action="/" class="mt-6 grid gap-4 border-y border-line py-5 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <label for="q" class="mb-1 block text-caption font-semibold">Company name or IČO</label>
      <input class="field" id="q" name="q" value={q} maxlength="500" placeholder="Search companies" />
    </div>

    <div>
      <label for="region" class="mb-1 block text-caption font-semibold">Region</label>
      <select class="field" id="region" name="region">
        <option value="">All regions</option>
        {Object.entries(regions).map(([code, label]) => (
          <option value={code} selected={region === code}>{label}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="district" class="mb-1 block text-caption font-semibold">District</label>
      <select class="field" id="district" name="district">
        <option value="">All districts</option>
        {Object.entries(districtsByRegion).map(([code, entries]) => (
          <optgroup label={regions[code]}>
            {entries.map(([value, label]) => (
              <option value={value} selected={district === value}>{label}</option>
            ))}
          </optgroup>
        ))}
      </select>
    </div>

    <div>
      <label for="size" class="mb-1 block text-caption font-semibold">Company size (employees)</label>
      <select class="field" id="size" name="size" aria-describedby="size-hint">
        <option value="">All sizes</option>
        {Object.entries(sizeBands).map(([code, band]) => (
          <option value={code} selected={size === code}>{band.label}</option>
        ))}
      </select>
    </div>

    <p id="size-hint" class="text-caption text-muted sm:col-span-2 lg:col-span-4">
      Turnover is not published as open data. Size is a proxy, see{' '}
      <a class="underline" href="/about">About the data</a>.
    </p>

    <div class="flex flex-wrap items-center gap-4 sm:col-span-2 lg:col-span-4">
      <label class="flex items-center gap-2">
        <input type="checkbox" name="includeDissolved" value="1" checked={includeDissolved} />
        Include dissolved
      </label>
      <button class="btn" type="submit">Filter</button>
      <a class="underline" href="/">Reset</a>
    </div>
  </form>

  <p class="my-5 text-caption">
    <strong>{result.total.toLocaleString('en-US')} companies</strong>
    <span class="text-muted"> · Data snapshot {date(meta.source_date)}</span>
  </p>

  {result.rows.length ? (
    <>
      <table class="data-table company-table">
        <caption class="sr-only">Companies matching the selected filters</caption>
        <thead>
          <tr>
            <th scope="col" class="w-[37%]">Name</th>
            <th scope="col">IČO</th>
            <th scope="col" class="hidden md:table-cell">Legal form</th>
            <th scope="col">Employees</th>
            <th scope="col">Town</th>
            <th scope="col" class="hidden md:table-cell">District</th>
          </tr>
        </thead>
        <tbody>
          {result.rows.map((c) => (
            <tr>
              <th scope="row">
                <a class="underline underline-offset-4" href={`/company/${c.ico}`}>{c.name}</a>
                {c.dissolved && <span class="block text-caption text-muted">Dissolved</span>}
              </th>
              <td class="tabular-nums">{c.ico}</td>
              <td class="hidden md:table-cell">{forms[c.form]?.short || c.form}</td>
              <td>{sizeShort(c.size)}</td>
              <td>{c.municipality || 'Not reported'}</td>
              <td class="hidden md:table-cell">{districts[c.district] || c.district}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <nav aria-label="Pagination" class="mt-6 flex items-center justify-between gap-3 text-caption">
        {result.page > 1 ? (
          <a class="btn btn-secondary" rel="prev" href={pageLink(result.page - 1)}>Previous</a>
        ) : (
          <span class="text-muted">Previous</span>
        )}
        <span>Page {result.page} of {result.pages.toLocaleString('en-US')}</span>
        {result.page < result.pages ? (
          <a class="btn btn-secondary" rel="next" href={pageLink(result.page + 1)}>Next</a>
        ) : (
          <span class="text-muted">Next</span>
        )}
      </nav>
    </>
  ) : (
    <p class="py-10">
      No companies match these filters. <a class="underline" href="/">Reset</a>
    </p>
  )}
</Layout>
