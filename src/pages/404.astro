---
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;
---

<Layout title="Not found | CZ Company Explorer">
  <h1 class="font-display text-h2">Page not found</h1>
  <p class="mt-4 text-text-soft">The address does not exist or the company is not in the dataset.</p>
  <p class="mt-8"><a class="btn" href="/">Back to the list</a></p>
</Layout>
